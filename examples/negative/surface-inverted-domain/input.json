    "playback": true,
    "parameter_sliders": ["a"]
  },
  "scenes": [
    {
      "id": "axes",
      "goal": "Fixture negativo.",
      "action": "draw_axes"
    },
    {
      "id": "curve",
      "goal": "Fixture negativo.",
      "action": "draw_curve"
    },
    {
      "id": "surface",
      "goal": "Fixture negativo.",
      "action": "rotate_curve_into_surface"
    }
  ],
  "checks": [
    "domain_is_valid",
    "derivative_exists_on_interval",
    "surface_parametrization_matches_axis",
    "area_formula_matches_surface_of_revolution"
  ]
