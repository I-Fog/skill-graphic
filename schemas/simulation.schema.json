{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.codex/skill-graphic/simulation.schema.json",
  "title": "Educational Simulation Contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "type", "title", "language", "parameters", "math", "scenes", "checks"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "type": {
      "type": "string",
      "enum": ["surface_of_revolution", "indefinite_integral", "function_graph"]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "language": {
      "type": "string",
      "enum": ["es", "en"]
    },
    "parameters": {
      "type": "object",
      "minProperties": 0,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["value", "domain"],
        "properties": {
          "value": {
            "type": ["number", "string"]
          },
          "domain": {
            "type": "string",
            "minLength": 1
          },
          "min": {
            "type": "number"
          },
          "max": {
            "type": "number"
          },
          "step": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "label": {
            "type": "string"
          }
        }
      }
    },
    "math": {
      "type": "object",
      "additionalProperties": false,
      "required": ["variable"],
      "properties": {
        "function": {
          "type": "string",
          "minLength": 1
        },
        "derivative": {
          "type": "string",
          "minLength": 1
        },
        "integrand": {
          "type": "string",
          "minLength": 1
        },
        "variable": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_]*$"
        },
        "domain": {
          "type": "array",
          "prefixItems": [
            { "type": "string" },
            { "type": "string" }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        },
        "anchor": {
          "type": "string",
          "minLength": 1
        },
        "rotation_axis": {
          "type": "string",
          "enum": ["x", "y", "z"]
        },
        "method": {
          "type": "string",
          "minLength": 1
        },
        "substitution": {
          "type": "string",
          "minLength": 1
        },
        "rational_integrand": {
          "type": "string",
          "minLength": 1
        },
        "partial_fractions": {
          "type": "string",
          "minLength": 1
        },
        "antiderivative_t": {
          "type": "string",
          "minLength": 1
        },
        "antiderivative": {
          "type": "string",
          "minLength": 1
        },
        "antiderivative_check": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "controls": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "camera": { "type": "boolean" },
        "playback": { "type": "boolean" },
        "parameter_sliders": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        }
      }
    },
    "features": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "special_points": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "kind", "x"],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]*$"
              },
              "kind": {
                "type": "string",
                "enum": ["root", "intersection", "extremum", "inflection", "custom"]
              },
              "x": {
                "type": "string",
                "minLength": 1
              },
              "y": {
                "type": "string",
                "minLength": 1
              },
              "label": {
                "type": "string"
              }
            }
          }
        },
        "highlighted_intervals": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "start", "end", "kind"],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]*$"
              },
              "start": {
                "type": "string",
                "minLength": 1
              },
              "end": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "type": "string",
                "enum": ["increasing", "decreasing", "positive", "negative", "area", "custom"]
              },
              "label": {
                "type": "string"
              }
            }
          }
        },
        "vertical_asymptotes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "kind", "x"],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]*$"
              },
              "kind": {
                "type": "string",
                "const": "vertical"
              },
              "x": {
                "type": "string",
                "minLength": 1
              },
              "label": {
                "type": "string"
              }
            }
          }
        },
        "discontinuities": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "kind", "x"],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]*$"
              },
              "kind": {
                "type": "string",
                "enum": ["removable", "jump", "essential", "custom"]
              },
              "x": {
                "type": "string",
                "minLength": 1
              },
              "label": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "goal", "action"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "goal": {
            "type": "string",
            "minLength": 1
          },
          "action": {
            "type": "string",
            "enum": [
              "draw_axes",
              "draw_curve",
              "highlight_interval",
              "show_rotation_axis",
              "rotate_curve_into_surface",
              "move_camera",
              "draw_function_graph",
              "trace_point",
              "show_tangent",
              "show_extrema",
              "show_inflection",
              "show_asymptote",
              "show_discontinuity",
              "show_derivative_graph",
              "show_antiderivative_graph",
              "compare_function_and_derivative",
              "draw_integrand_graph",
              "sweep_signed_area",
              "draw_primitive_curve",
              "show_primitive_family",
              "introduce_substitution",
              "transform_integrand",
              "split_partial_fractions",
              "integrate_terms",
              "back_substitute",
              "verify_derivative",
              "show_formula",
              "show_validation"
            ]
          },
          "duration_ms": {
            "type": "integer",
            "minimum": 0
          },
          "caption": {
            "type": "string"
          },
          "formula": {
            "type": "string"
          },
          "targets": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "args": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "point_id": {
                "type": "string",
                "minLength": 1
              },
              "x": {
                "type": ["string", "number"]
              },
              "start": {
                "type": ["string", "number"]
              },
              "end": {
                "type": ["string", "number"]
              },
              "direction": {
                "type": "string",
                "enum": ["left", "right", "up", "down", "clockwise", "counterclockwise"]
              }
            }
          }
        }
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": [
          "domain_is_valid",
          "derivative_exists_on_interval",
          "surface_parametrization_matches_axis",
          "area_formula_matches_surface_of_revolution",
          "function_expression_is_valid",
          "visual_domain_is_ordered",
          "derivative_matches_function",
          "antiderivative_matches_function",
          "declared_points_match_function",
          "declared_intervals_match_function",
          "declared_asymptotes_match_function",
          "declared_discontinuities_match_function",
          "integrand_matches_statement",
          "visual_domain_avoids_singularities",
          "weierstrass_substitution_is_valid",
          "rational_integrand_matches_substitution",
          "partial_fractions_match",
          "antiderivative_differentiates_to_integrand"
        ]
      },
      "uniqueItems": true
    },
    "expected_failure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phase"],
      "properties": {
        "phase": {
          "type": "string",
          "enum": ["schema", "contract", "math", "generator"]
        },
        "check": {
          "type": "string",
          "minLength": 1
        },
        "message_contains": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "type": { "const": "surface_of_revolution" } },
        "required": ["type"]
      },
      "then": {
        "properties": {
          "math": {
            "properties": {
              "rotation_axis": { "const": "x" }
            },
            "required": ["function", "variable", "domain", "rotation_axis"]
          }
        }
      }
    },
    {
      "if": {
        "properties": { "type": { "const": "function_graph" } },
        "required": ["type"]
      },
      "then": {
        "properties": {
          "math": {
            "required": ["function", "variable", "domain"]
          }
        }
      }
    },
    {
      "if": {
        "properties": { "type": { "const": "indefinite_integral" } },
        "required": ["type"]
      },
      "then": {
        "properties": {
          "math": {
            "required": [
              "integrand",
              "variable",
              "domain",
              "anchor",
              "method",
              "substitution",
              "rational_integrand",
              "partial_fractions",
              "antiderivative_t",
              "antiderivative",
              "antiderivative_check"
            ]
          }
        }
      }
    }
  ]
}
